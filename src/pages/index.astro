---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostStream from '@components/PostStream.astro';
import { SITE } from '@config';
import { getPublishedPosts } from '@utils/posts';

// The home page mixes entries and links in one reverse-chronological stream;
// /entries/ and /links/ are the per-type archives.
const posts = await getPublishedPosts();
---

<BaseLayout>
  <p class="intro">{SITE.description}</p>
  <PostStream posts={posts} empty="아직 글이 없습니다. 첫 글을 src/posts/ 에 추가해 보세요." />
</BaseLayout>
