---
import { render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import LinkThread from '@components/LinkThread.astro';
import {
  getPublishedPosts,
  getThreadPosts,
  getThreadOpener,
  getDateFromId,
  formatDate,
  getWordCount,
  getOgImage,
  getSlugFromId,
  assertUniqueIds,
} from '@utils/posts';

// A thread is one page, not one page per note: the notes after the first are
// anchors on the opening note's permalink. So only openers and unthreaded
// links get a route here — see getPostUrls, which every link on the site
// resolves through.
export async function getStaticPaths() {
  await assertUniqueIds();
  const posts = await getPublishedPosts('link');
  const pages = await Promise.all(
    posts.map(async (post) => {
      const thread = post.data.thread ? await getThreadPosts(post.data.thread) : [post];
      return { post, thread, isOpener: getThreadOpener(thread).id === post.id };
    }),
  );
  return pages
    .filter((p) => p.isOpener)
    .map(({ post, thread }) => ({ params: { id: String(post.data.id) }, props: { post, thread } }));
}

const { post, thread } = Astro.props;
const { Content } = await render(post);
const dateISO = getDateFromId(post.id);

// One note isn't a timeline yet: it reads better as a plain link post, and the
// line and dots start earning their place at the second note.
const threaded = thread.length > 1;
// The page is the thread, so its share card can come from any note — the book
// cover usually sits on the first one.
const image = thread.map(getOgImage).find(Boolean);
---

{/* Links get no prev/next: PostLayout drops that nav for them anyway. */}
<PostLayout
  title={post.data.title}
  slug={getSlugFromId(post.id)}
  type={post.data.type}
  link={post.data.link}
  description={post.data.description}
  image={image}
  dateISO={dateISO}
  dateDisplay={formatDate(dateISO)}
  words={getWordCount(post.body || '')}
  tags={post.data.tags}
  threaded={threaded}
  older={null}
  newer={null}
>
  {threaded ? <LinkThread notes={thread} /> : <Content />}
</PostLayout>
