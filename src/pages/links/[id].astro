---
import { render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import {
  getPublishedPosts,
  getDateFromId,
  formatDate,
  getWordCount,
  getOgImage,
  getSlugFromId,
  assertUniqueIds,
} from '@utils/posts';

export async function getStaticPaths() {
  await assertUniqueIds();
  const posts = await getPublishedPosts('link');
  return posts.map((post) => ({ params: { id: String(post.data.id) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateISO = getDateFromId(post.id);
---

{/* Links get no prev/next: PostLayout drops that nav for them anyway. */}
<PostLayout
  title={post.data.title}
  slug={getSlugFromId(post.id)}
  type={post.data.type}
  link={post.data.link}
  description={post.data.description}
  image={getOgImage(post)}
  dateISO={dateISO}
  dateDisplay={formatDate(dateISO)}
  words={getWordCount(post.body || '')}
  tags={post.data.tags}
  older={null}
  newer={null}
>
  <Content />
</PostLayout>
