---
import { render } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import LinkThread from '@components/LinkThread.astro';
import {
  getPublishedPosts,
  getThreadPosts,
  getDateFromId,
  formatDate,
  getWordCount,
  getOgImage,
  getSlugFromId,
  assertUniqueIds,
} from '@utils/posts';

export async function getStaticPaths() {
  await assertUniqueIds();
  const posts = await getPublishedPosts('link');
  return posts.map((post) => ({ params: { id: String(post.data.id) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateISO = getDateFromId(post.id);

// A thread that still holds one note reads better as a plain link post: the
// timeline only earns its line and dots once there's a second thought to
// compare against. Metadata stays this post's either way — the siblings are
// related notes on this page, not part of what it is.
const thread = post.data.thread ? await getThreadPosts(post.data.thread) : [];
const threaded = thread.length > 1;
---

{/* Links get no prev/next: PostLayout drops that nav for them anyway. */}
<PostLayout
  title={post.data.title}
  slug={getSlugFromId(post.id)}
  type={post.data.type}
  link={post.data.link}
  description={post.data.description}
  image={getOgImage(post)}
  dateISO={dateISO}
  dateDisplay={formatDate(dateISO)}
  words={getWordCount(post.body || '')}
  tags={post.data.tags}
  threaded={threaded}
  older={null}
  newer={null}
>
  {threaded ? <LinkThread posts={thread} currentId={post.id} /> : <Content />}
</PostLayout>
