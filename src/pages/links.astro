---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostStream from '@components/PostStream.astro';
import { getPublishedPosts } from '@utils/posts';

const posts = await getPublishedPosts('link');
---

<BaseLayout title="Links" description="읽고 짧게 남긴 것들">
  <h1 class="archive-title">Links</h1>
  <p class="intro">읽고 짧게 남긴 것 {posts.length}개.</p>
  <PostStream posts={posts} empty="아직 남긴 링크가 없습니다." />
</BaseLayout>
