---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostStream from '@components/PostStream.astro';
import { getPublishedPosts } from '@utils/posts';

const posts = await getPublishedPosts('entry');
---

<BaseLayout title="Entries" description="업무에서 겪고 배운 것들" sidebar>
  <h1 class="archive-title">Entries</h1>
  <p class="intro">일하면서 겪고 배운 것 {posts.length}편.</p>

  <PostStream posts={posts} empty="아직 쓴 글이 없습니다." />
</BaseLayout>
