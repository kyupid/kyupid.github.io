---
import BaseLayout from './BaseLayout.astro';
import ScrollProgress from '@components/ScrollProgress.astro';
import Comments from '@components/Comments.astro';
import { getLinkHost, type PostType } from '@utils/posts';

interface Adjacent {
  title: string;
  url: string;
}

interface Props {
  title: string;
  /** Filename slug, used as the stable giscus thread key. */
  slug: string;
  type: PostType;
  /** Source URL, set for type: link. */
  link?: string;
  description?: string;
  image?: string;
  dateISO: string;
  dateDisplay: string;
  words: number;
  tags: string[];
  /** Set when the body is a thread timeline, which carries its own dates. */
  threaded?: boolean;
  older: Adjacent | null;
  newer: Adjacent | null;
}

const {
  title,
  slug,
  type,
  link,
  description,
  image,
  dateISO,
  dateDisplay,
  words,
  tags,
  threaded = false,
  older,
  newer,
} = Astro.props;
const wordStr = words.toLocaleString('en-US');

// A link is a couple of sentences about someone else's writing. It keeps a
// permalink for the feed, but a word count, prev/next nav and a comment thread
// would all outweigh the post itself.
const isLink = type === 'link';
---

<BaseLayout title={title} description={description} image={image}>
  <article class:list={[isLink && 'link-post']}>
    {
      isLink ? (
        <h1 class="post-title">
          <a href={link}>{title}</a>
        </h1>
      ) : (
        <h1 class="post-title">{title}</h1>
      )
    }
    <div class="post-meta">
      {/* A thread dates each note on its own row, so the header would only
          repeat one of them. */}
      {!threaded && <time datetime={dateISO}>{dateDisplay}</time>}
      {
        isLink ? (
          <>
            {!threaded && <span class="dot">·</span>}
            <a class="post-source" href={link}>
              {getLinkHost(link!)}
            </a>
          </>
        ) : (
          <>
            <span class="dot">·</span>
            {wordStr} words
          </>
        )
      }
    </div>

    {
      /* Links get their source's image here: a book cover or a header card is
         what the note is about, and the stream already shows it. Entries don't,
         because their `image` is just the first picture in the body. */
      isLink && image && (
        <a class="link-cover" href={link}>
          <img src={image} alt="" />
        </a>
      )
    }

    <div class="post-content" data-pagefind-body>
      <slot />
    </div>

    {
      tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => (
            <span>{'#' + t}</span>
          ))}
        </div>
      )
    }

    {
      !isLink && (older || newer) && (
        <nav class="adjacent">
          {older ? (
            <a class="prev" href={older.url}>
              <span class="lbl">이전 글</span>
              {older.title}
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a class="next" href={newer.url}>
              <span class="lbl">다음 글</span>
              {newer.title}
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>

  {!isLink && <Comments term={slug} />}

  {/* Links get it too: a thread runs long enough to want the ride back up,
      and the button only appears past 400px, so a two-sentence note never
      shows one. */}
  <ScrollProgress />
</BaseLayout>
