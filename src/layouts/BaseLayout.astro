---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Sidebar from '@components/Sidebar.astro';
import { SITE } from '@config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /**
   * Two-column with the sidebar, on the stream pages. Post pages stay single
   * column at the original 800px so the reading measure doesn't change.
   */
  sidebar?: boolean;
}

const { title, description, image, sidebar = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const desc = description || SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Every page gets a share card: the page's own image, else the site default.
const ogImage = new URL(image || SITE.ogImage, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <slot name="head" />

    {
      /* Analytics: cookieless pageview count. Production builds only, so `astro dev`
         and local previews never pollute the stats. */
      import.meta.env.PROD && SITE.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <div class:list={['wrap', sidebar && 'wrap-wide']}>
      <Header />
      {
        sidebar ? (
          /* Sidebar sits after main in the DOM so small screens and screen
             readers get the posts first. */
          <div class="with-sidebar">
            <main>
              <slot />
            </main>
            <Sidebar />
          </div>
        ) : (
          <main>
            <slot />
          </main>
        )
      }
      <Footer />
    </div>
  </body>
</html>
