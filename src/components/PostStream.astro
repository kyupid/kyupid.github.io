---
import {
  getPostUrls,
  getDateFromId,
  formatDate,
  formatDateRange,
  getExcerpt,
  getOgImage,
  getLinkHost,
  collapseThreads,
  type Post,
} from '@utils/posts';

interface Props {
  posts: Post[];
  empty?: string;
}

const { posts, empty = '아직 글이 없습니다.' } = Astro.props;

const urls = getPostUrls(posts);

const items = collapseThreads(posts).map(({ post: p, threadTotal, notes }) => {
  const date = getDateFromId(p.id);
  const isLink = p.data.type === 'link';
  // A folded thread spans from its first note to its last, so the row says so
  // instead of naming the opening date alone.
  const dates = notes.map((n) => getDateFromId(n.id)).sort();
  const range = formatDateRange(dates[0], dates[dates.length - 1]);
  return {
    isLink,
    // The title stays on the site: a link's note is worth reading before its
    // source, and a thread's other notes only exist behind this permalink.
    // The "링크" chip is what leaves for the source.
    permalink: urls.get(p.id)!,
    source: isLink ? p.data.link! : null,
    host: isLink ? getLinkHost(p.data.link!) : null,
    title: p.data.title,
    date,
    display: formatDate(date),
    range,
    lastDate: dates[dates.length - 1],
    // Links run two or three sentences, so show the whole note rather than a teaser.
    body: isLink ? getExcerpt(p.body || '', 400) : p.data.description || getExcerpt(p.body || ''),
    tags: p.data.tags,
    // "노트 3": how many notes stand behind this row. The row is always the
    // opening note, so a position like "1/3" would never say anything else.
    threadTotal,
    // Undefined for text-only posts: those render without a thumbnail rather
    // than falling back to the shared OG card. A link only gets one if its
    // frontmatter names an image saved under public/images/links/. A folded
    // thread looks across its notes: the book cover belongs to the subject, so
    // it shouldn't vanish because the newest note didn't repeat it.
    thumb: notes.map(getOgImage).find(Boolean),
  };
});
---

{
  items.length === 0 ? (
    <p class="intro">{empty}</p>
  ) : (
    <div class="entry-list">
      {items.map((e) => (
        <article class:list={['entry', e.isLink && 'is-link', e.thumb && 'has-thumb']}>
          <div class="entry-main">
            <div class="entry-date">
              <time datetime={e.date}>{e.range.from}</time>
              {e.range.to && (
                <>
                  <span class="date-sep">–</span>
                  <time datetime={e.lastDate}>{e.range.to}</time>
                </>
              )}
              {e.source && (
                <a class="entry-kind" href={e.source}>
                  링크
                </a>
              )}
            </div>
            <a class="entry-title" href={e.permalink}>
              {e.title}
            </a>
            {e.host && (
              <div class="entry-host">
                <a href={e.source!}>{e.host}</a>
              </div>
            )}
            {e.body && <p class="entry-excerpt">{e.body}</p>}
            {(e.tags.length > 0 || e.threadTotal > 1) && (
              <div class="entry-foot">
                {e.tags.length > 0 && (
                  <div class="entry-tags">
                    {e.tags.map((t) => (
                      <span>{t}</span>
                    ))}
                  </div>
                )}
                {e.threadTotal > 1 && (
                  <a class="entry-thread" href={e.permalink}>
                    노트 {e.threadTotal}
                  </a>
                )}
              </div>
            )}
          </div>
          {e.thumb && (
            /* Decorative duplicate of the title link: skipped by screen readers
               and keyboard tabbing so each entry stays a single stop. */
            <a class="entry-thumb" href={e.permalink} aria-hidden="true" tabindex="-1">
              <img src={e.thumb} alt="" loading="lazy" decoding="async" />
            </a>
          )}
        </article>
      ))}
    </div>
  )
}
