---
// Fixed table of contents, parked in the right gutter of an entry page.
// The reading column stays 800px wide, so this only appears once the viewport
// has room beside it; below that breakpoint the post reads as it always has.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Post title. Slides in above the list once the real h1 has scrolled away. */
  title: string;
}

const { headings, title } = Astro.props;

// h2 and h3 only: h1 inside a body is rare and h4 is usually a detail of the
// paragraph above it, not a place anyone navigates to. The autolink plugin
// appends a '#' to each heading, which rides along in the collected text.
const items = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, '') }));

// One entry is a list of one — it points at the page you're already on.
const show = items.length >= 2;
---

{
  show && (
    <nav class="toc" id="toc" aria-label="목차">
      {/* Collapsed while the page's own title is on screen. As that scrolls
          out, this one grows in and settles at a smaller size, so the reader
          never loses sight of what they're reading. */}
      <div class="toc-heading-wrap" id="toc-heading-wrap" aria-hidden="true">
        <p class="toc-heading">{title}</p>
      </div>
      <ul>
        {items.map((h) => (
          <li class:list={['toc-item', `d${h.depth}`]}>
            <a href={`#${h.slug}`} data-slug={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    display: none;
  }

  /* 800px column + a gutter wide enough for 200px of list. Narrower than this
     and the two would collide. */
  @media (min-width: 1280px) {
    .toc {
      display: block;
      position: fixed;
      top: 120px;
      right: max(20px, calc(50% - 624px));
      width: 200px;
      max-height: calc(100vh - 200px);
      overflow-y: auto;
      overscroll-behavior: contain;
      border-left: 1px solid var(--rule);
      padding-left: 14px;
      font-size: 0.82rem;
      line-height: 1.45;
      z-index: 20;
    }
  }

  /* --p runs 0 → 1 as the h1 leaves the viewport; the script sets it. */
  .toc {
    --p: 0;
  }
  .toc-heading-wrap {
    overflow: hidden;
    max-height: 0;
    opacity: var(--p);
    transform: translateY(calc((1 - var(--p)) * 6px));
    margin-bottom: calc(var(--p) * 16px);
  }
  .toc-heading {
    margin: 0;
    color: var(--text);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    /* 1.2rem at the moment it appears, shrinking to 0.95rem once settled. */
    font-size: calc(0.95rem + (1 - var(--p)) * 0.25rem);
    text-wrap: balance;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-item + .toc-item {
    margin-top: 7px;
  }
  .toc-item.d3 {
    padding-left: 12px;
  }
  .toc a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .toc a:hover {
    color: var(--link);
  }
  .toc a.active {
    color: var(--text);
    font-weight: 600;
  }

  /* A thin scrollbar for a long post's list, so it doesn't draw attention. */
  .toc {
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }
</style>

<script>
  const toc = document.getElementById('toc');
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-slug]'));
    const entries = links
      .map((a) => ({ link: a, target: document.getElementById(a.dataset.slug!) }))
      .filter((e): e is { link: HTMLAnchorElement; target: HTMLElement } => e.target !== null);

    let active: HTMLAnchorElement | null = null;

    // Title hand-off: progress is how far the page h1 has scrolled past the
    // top of the fixed list. It starts when the h1's top reaches the list
    // and completes 160px later, which is about the time the h1 is fully gone.
    const h1 = document.querySelector<HTMLElement>('.post-title');
    const wrap = document.getElementById('toc-heading-wrap');
    const heading = wrap?.firstElementChild as HTMLElement | null;
    const TOC_TOP = 120;
    const RANGE = 160;
    let lastP = -1;
    let settledHeight = 0;

    // The wrap opens toward the height the title has once it has finished
    // shrinking. Measuring at the current, larger size would overshoot and
    // then bounce the list back up.
    const measure = () => {
      if (!wrap || !heading) return;
      const prev = toc.style.getPropertyValue('--p');
      toc.style.setProperty('--p', '1');
      settledHeight = heading.offsetHeight;
      toc.style.setProperty('--p', prev);
      lastP = -1;
    };

    const updateTitle = () => {
      if (!h1 || !wrap || !heading) return;
      const passed = TOC_TOP - h1.getBoundingClientRect().top;
      const p = Math.min(Math.max(passed / RANGE, 0), 1);
      if (p === lastP) return;
      lastP = p;
      toc.style.setProperty('--p', p.toFixed(3));
      wrap.style.maxHeight = `${p * settledHeight}px`;
    };

    const update = () => {
      updateTitle();
      // The heading a reader is under is the last one that has passed the top
      // of the viewport — not the next one coming into view.
      let current = entries[0];
      for (const e of entries) {
        if (e.target.getBoundingClientRect().top <= 120) current = e;
        else break;
      }
      // Past the end of the article, the last heading is the honest answer.
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = entries[entries.length - 1];
      }
      const next = current?.link ?? null;
      if (next === active) return;
      active?.classList.remove('active');
      next?.classList.add('active');
      active = next;
      // Keep the marker in sight when the list is long enough to scroll.
      if (next && toc.scrollHeight > toc.clientHeight) {
        next.scrollIntoView({ block: 'nearest' });
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      onScroll();
    }, { passive: true });
    measure();
    update();
  }
</script>
