---
import { SITE } from '@config';

const items = [
  { key: 'linkedin', link: SITE.social.linkedin, label: 'LinkedIn', external: true },
  { key: 'rss', link: '/feed.xml', label: 'RSS', external: false },
];

const icons: Record<string, string> = {
  linkedin:
    '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z"/>',
  rss:
    '<path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44v3.57A12.01 12.01 0 0 1 15.99 20h3.57A15.57 15.57 0 0 0 4 4.44zM4 10.1v3.57c3.5 0 6.33 2.84 6.33 6.33h3.57c0-5.47-4.43-9.9-9.9-9.9z"/>',
};
---

<span class="social">
  {
    items.map((it) => (
      <a
        href={it.link}
        aria-label={it.label}
        target={it.external ? '_blank' : undefined}
        rel={it.external ? 'noopener noreferrer' : undefined}
      >
        <svg viewBox="0 0 24 24" set:html={icons[it.key]} />
      </a>
    ))
  }
</span>
