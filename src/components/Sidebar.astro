---
import { SITE } from '@config';
import { getPublishedPosts, getPostPath, getDateFromId, formatDate } from '@utils/posts';

// Resolve the configured ids to real posts, so a highlight can never point at
// a hidden or deleted post and a renamed post updates its own label.
const posts = await getPublishedPosts();
const byId = new Map(posts.map((p) => [p.data.id, p]));
const highlights = SITE.highlights.map((id) => byId.get(id)).filter((p) => p !== undefined);
---

<aside class="sidebar">
  <section class="side-block">
    <h2 class="side-title">소개</h2>
    <p class="side-bio">{SITE.bio}</p>
  </section>

  <section class="side-block">
    <h2 class="side-title">AI 사용 방침</h2>
    <p class="side-bio">
      판단과 의견이 들어간 문장은 직접 씁니다. AI에게는 맞춤법과 비문 교정만 맡기고, 겪지 않은 경험을
      채워 넣게 하지 않습니다.
    </p>
    <p class="side-role">
      <a
        href="https://simonwillison.net/2026/Mar/1/ai-writing/"
        target="_blank"
        rel="noopener noreferrer">Simon Willison의 방침</a
      >을 참고했습니다.
    </p>
  </section>

  {
    highlights.length > 0 && (
      <section class="side-block">
        <h2 class="side-title">Highlights</h2>
        <ul class="side-list">
          {highlights.map((p) => {
            const date = getDateFromId(p.id);
            return (
              <li>
                <a href={getPostPath(p)}>{p.data.title}</a>
                <time class="side-date" datetime={date}>
                  {formatDate(date)}
                </time>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</aside>
