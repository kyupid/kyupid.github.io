---
import { render } from 'astro:content';
import { getNoteAnchor, getDateFromId, formatDate, type Post } from '@utils/posts';

interface Props {
  /** The thread's notes, oldest first. */
  notes: Post[];
}

const { notes } = Astro.props;

// Each note is rendered here rather than in the page so the page keeps passing
// a single slot to PostLayout.
const items = await Promise.all(
  notes.map(async (post) => {
    const { Content } = await render(post);
    const date = getDateFromId(post.id);
    return {
      Content,
      date,
      display: formatDate(date),
      anchor: getNoteAnchor(post),
    };
  }),
);
---

<ol class="thread">
  {
    items.map((item) => (
      /* The date is a fragment link, not a permalink: a note has no page of its
         own, so sharing one scrolls into this thread and :target marks it. */
      <li class="thread-item" id={item.anchor}>
        {/* The rail repeats that same link over the line and the dot, so the
            timeline itself is clickable and not just the date text. */}
        <a class="thread-rail" href={`#${item.anchor}`} aria-hidden="true" tabindex={-1} />
        <a class="thread-date" href={`#${item.anchor}`}>
          <time datetime={item.date}>{item.display}</time>
        </a>
        <div class="thread-body">
          <item.Content />
        </div>
      </li>
    ))
  }
</ol>
