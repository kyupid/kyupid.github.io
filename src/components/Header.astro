---
import { SITE } from '@config';
import Search from './Search.astro';
import Social from './Social.astro';
import { getPublishedMaterials } from '@utils/materials';

// Mark the archive we're currently on. trailingSlash is 'always', so the
// pathname is "/links/" rather than "/links".
const path = Astro.url.pathname;
// Timeline points at '/' rather than its own URL: the home page already is the
// mixed stream, and a second URL with identical content would just split it.
// Materials only joins the nav once there's something behind it: a tab that
// opens on an empty grid reads as an unfinished site. It appears on its own
// with the first material, so there's nothing to remember to turn on.
const hasMaterials = (await getPublishedMaterials()).length > 0;
const nav = [
  { href: '/', label: 'Timeline' },
  { href: '/entries/', label: 'Entries' },
  { href: '/links/', label: 'Links' },
  ...(hasMaterials ? [{ href: '/materials/', label: 'Materials' }] : []),
];
---

<header class="masthead">
  <div class="masthead-top">
    <div class="brand">
      <a class="brand-home" href="/">
        <img class="avatar" src="/avatar.jpg" alt={SITE.author} width="88" height="88" />
        <span>{SITE.title}</span>
      </a>
      <small>{SITE.tagline}</small>
    </div>
    <div class="masthead-tools">
      <Search />
      <Social />
    </div>
  </div>
  <nav class="masthead-nav">
    {
      nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
          {n.label}
        </a>
      ))
    }
  </nav>
</header>
