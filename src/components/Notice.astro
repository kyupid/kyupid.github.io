---
/**
 * 글머리에 두는 고지 상자. 본문 인용(>)과 구분되도록 색과 라벨을 준다.
 * 사용: <Notice label="이 글에 대하여">내용</Notice>
 */
interface Props {
  label?: string;
}
const { label = '알림' } = Astro.props;
---

<aside class="notice">
  <p class="notice-label">{label}</p>
  <div class="notice-body"><slot /></div>
</aside>

<style>
  .notice {
    margin: 1.6rem 0 2.2rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--link);
    border-radius: 8px;
    background: var(--accent-soft);
  }
  .notice-label {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--link);
  }
  .notice-body {
    font-size: 0.93rem;
    line-height: 1.7;
    color: var(--text);
  }
  .notice-body :global(p) {
    margin: 0;
  }
</style>
